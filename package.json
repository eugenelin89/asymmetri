{
  "name": "asymmetri-labs-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "dev:next": "next dev",
    "build:next": "next build",
    "check": "npm run typecheck && npm run lint",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "receiver:check": "npm --prefix receiver run check",
    "receiver:test": "npm --prefix receiver test",
    "receiver:build": "npm --prefix receiver run build",
    "receiver:start": "npm --prefix receiver start",
    "test:investment": "node --test tests/investment.test.mjs",
    "showcase:preview": "npm run receiver:build && node receiver/dist/test/showcase-preview.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.13.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "autoprefixer": "10.4.20",
    "eslint": "9.32.0",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.25",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.5"
  },
  "type": "module"
}
