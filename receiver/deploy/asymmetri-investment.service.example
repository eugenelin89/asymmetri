# Explicit-start private installation. See docs/INFRA-02-RECEIVER-DEPLOYMENT.md.
# No [Install] section: no boot enablement or implicit publication authority.
[Unit]
Description=Asymmetri private investment archive receiver
After=network.target
ConditionPathExists=/etc/asymmetri-investment/explicitly-enabled
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=asymmetri-investment
Group=asymmetri-investment
WorkingDirectory=/opt/asymmetri-receiver/receiver
Environment=NODE_ENV=production
Environment=ASYMMETRI_RECEIVER_CONFIG=/etc/asymmetri-investment/config.json
ExecStart=/usr/bin/node --max-old-space-size=128 dist/src/cli.js serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
# Hide unrelated websites, retained data/backups, sockets and application trees.
# Bind back only this root-owned release and its private writable archive.
TemporaryFileSystem=/var:ro /run:ro /opt:ro /srv:ro
BindReadOnlyPaths=/opt/asymmetri-receiver
BindPaths=/var/lib/asymmetri-investment
InaccessiblePaths=-/etc/nginx -/etc/letsencrypt -/etc/ssh -/etc/ssl/private
ReadWritePaths=/var/lib/asymmetri-investment
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=256M
MemorySwapMax=64M
TasksMax=32
CPUQuota=50%
